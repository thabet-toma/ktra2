# انسخ هذا الملف إلى `.env` في نفس مجلد `manage.py` (جذر مشروع Django: مثل Desktop\ktra)
# Django يقرأ `.env` تلقائياً بعد تثبيت python-dotenv — لا ترفع `.env` إلى git

# Django
# استخدم development محلياً وproduction على الخادم؛ ناشر الإنتاج يرفض أي قيمة أخرى.
DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me-in-production
# إيقاف ترحيل دفعات الصفقة تلقائياً من signals (قيد شراء من الصفقة معطّل في الكود؛ استخدم purchase-receipts للمخزون)
# LOGISTICS_DISABLE_AUTO_ACCOUNTING=1
# إيقاف القيد التلقائي لدفعات الصفقة بعد تأكيد المورد (الافتراضي: مفعّل الترحيل التلقائي)
# LOGISTICS_PAYMENT_SKIP_AUTO_JOURNAL=1
# كود حساب الأب لربط صناديق النقدية في الشجرة (افتراضي 1110)
# CASH_BOX_PARENT_ACCOUNT_CODE=1110
# كود حساب حقوق الملكية/رأس المال لقيد «إيداع صندوق» (مدين صندوق | دائن رأس مال). إن تُرك فارغاً يُستخدم أول Equity.
# CASH_BOX_CAPITAL_ACCOUNT_CODE=3010
# معرّف Firestore لصندوق الدولار (أو الافتراضي) — يُستخدم عند ترحيل دفعة بدون تمرير cash_box_external_id
# DEFAULT_CASH_BOX_EXTERNAL_ID=
DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,myserver.com
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# إن فتحت Vite من IP الشبكة (مثل http://192.168.1.5:5173) أضف نفس الأصل هنا:
# DJANGO_CORS_EXTRA_ORIGINS=http://192.168.1.5:5173
# للتجربة فقط (يفتح CORS لكل المصادر):
# DJANGO_CORS_ALLOW_ALL=1

# MySQL
MYSQL_DATABASE=global_erp_pro
MYSQL_USER=root
# التطوير المحلي قد يستخدم كلمة فارغة؛ الإنتاج يرفض التشغيل إن بقيت فارغة.
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
 
# Cloudinary (رفع الصور)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# اختياري: حساب Cloudinary منفصل لأمر rehost_http_media_to_cloudinary (نسخ من روابط قديمة)
# CLOUDINARY_REHOST_CLOUD_NAME=
# CLOUDINARY_REHOST_API_KEY=
# CLOUDINARY_REHOST_API_SECRET=

# AI Agent - مفتاح API لنقطة استعلام قاعدة البيانات (X-Agent-Key)
# غيّر هذه القيمة الى مفتاح عشوائي قوي في الانتاج
AGENT_DB_API_KEY=change-me-to-a-strong-random-key

# المساعد الذكي (BFF → OpenClaw على سيرفر منفصل): التوكن والروابط في بيئة خادم Django فقط
# OPENCLAW_MESSAGES_URL=http://72.60.181.210:18789/v1/messages
# OPENCLAW_FILES_URL=http://72.60.181.210:18789/v1/files
# OPENCLAW_STATUS_URL=http://72.60.181.210:18789/v1/status
# OPENCLAW_BEARER_TOKEN=
# الإنتاج يتطلب OPENCLAW_BEARER_TOKEN غير فارغاً قبل بدء النشر.
# WebSocket (اختياري): pip install websocket-client — يُشتق ws:// من OPENCLAW_MESSAGES_URL + ?token=
# OPENCLAW_WS_MESSAGES_URL=
# OPENCLAW_USE_WEBSOCKET=0
# OPENCLAW_ASSISTANT_TIMEOUT=600

# المساعد الذكي عبر Ollama (Qwen) — يجيب من قاعدة بيانات كترا عبر أدوات مقفولة على الشركة
# ASSISTANT_BACKEND=ollama          # ollama (الافتراضي) أو openclaw
# السحابة: https://ollama.com/v1  — أو خادم Ollama محلي: http://IP:11434/v1
# OLLAMA_BASE_URL=https://ollama.com/v1
# OLLAMA_API_KEY=                   # سرّي — لا يوضع في git. جدّد المفتاح إن تسرّب.
# الموديل: qwen3.6 محلي فقط (غير متاح سحابياً). qwen3.5:397b يتطلب اشتراك مدفوع.
# المجاني الذي يدعم الأدوات: gpt-oss:120b (الافتراضي) أو gpt-oss:20b.
# للتبديل لكوين المدفوع: OLLAMA_MODEL=qwen3.5:397b
# OLLAMA_MODEL=gpt-oss:120b
# OLLAMA_ASSISTANT_TIMEOUT=120

# frontend v2 / Vite (في مجلد frontend_v2 عند البناء)
# يجب أن ينتهي بـ /api — وإن وصلت للواجهة من جهاز آخر استبدل localhost بعنوان السيرفر
# VITE_API_URL=http://127.0.0.1:8000/api
# VITE_GEMINI_API_KEY=

# frontend v1 CRA (اختياري)
# REACT_APP_API_BASE=http://127.0.0.1:8000/api
